<?xml version="1.0" encoding="utf-8"?>
<!--
  PhotoSweet MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build photosweet.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc photosweet.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder
  (Program Files\PhotoSweet by default, remembered for upgrades), Ready, a progress page, and a
  Finish page with a ticked "Launch PhotoSweet" box. Installs a Start Menu shortcut, makes
  PhotoSweet the owner of `.psweet`, and offers it under "Open with" for PSD/PSB and the image
  formats it reads (without taking over the user's default app for them), plus photosweet-cli.
  `msiexec /qn` still installs silently.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="PhotoSweet"
      Manufacturer="salim-slimani"
      Version="$(var.Version)"
      UpgradeCode="D9660F32-2D0A-4ABE-B73D-17BE25F1542C"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="PhotoSweet image editor" Manufacturer="salim-slimani" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of PhotoSweet is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="PhotosweetIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="PhotosweetIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://salim-studio.github.io/photosweet/apps/photosweet" />
    <Property Id="ARPURLUPDATEINFO" Value="https://salim-studio.github.io/photosweet/apps/photosweet" />
    <Property Id="ARPHELPLINK" Value="https://github.com/salim-studio/photosweet" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="PhotoSweet" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by PhotosweetApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\PhotoSweet" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="PhotoSweet" Level="1">
      <ComponentGroupRef Id="PhotosweetFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchPhotosweet"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through photosweet.en-us.wxl. -->
    <Property Id="PhotosweetVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="PhotoSweet $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch PhotoSweet" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#PhotosweetExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchPhotosweet" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="PhotosweetFiles" Directory="INSTALLFOLDER">
      <Component Id="PhotosweetApp" Guid="A6DE41B7-A80F-4C59-A17E-BB68065BF67E">
        <File Id="PhotosweetExe" Source="$(var.BinDir)\photosweet.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="PhotoSweet"
              Description="PhotoSweet image editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="PhotosweetIcon.exe" IconIndex="0" />
        </File>

        <!-- .psweet: PhotoSweet's own format; PhotoSweet is its default app. -->
        <ProgId Id="Photosweet.Document" Description="PhotoSweet Document" Icon="PhotosweetExe" IconIndex="0">
          <Extension Id="psweet" ContentType="application/x-photosweet">
            <Verb Id="open" Command="Open" TargetFile="PhotosweetExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- PSD/PSB and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="Photosweet.PhotoshopDocument" Description="PSD Document" Icon="PhotosweetExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Photosweet.PhotoshopDocument\shell\open\command" Value="&quot;[#PhotosweetExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="Photosweet.Image" Description="Image" Icon="PhotosweetExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Photosweet.Image\shell\open\command" Value="&quot;[#PhotosweetExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.psd\OpenWithProgids" Name="Photosweet.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.psb\OpenWithProgids" Name="Photosweet.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pdn\OpenWithProgids" Name="Photosweet.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ora\OpenWithProgids" Name="Photosweet.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.kra\OpenWithProgids" Name="Photosweet.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.krz\OpenWithProgids" Name="Photosweet.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.png\OpenWithProgids" Name="Photosweet.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpg\OpenWithProgids" Name="Photosweet.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpeg\OpenWithProgids" Name="Photosweet.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tif\OpenWithProgids" Name="Photosweet.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tiff\OpenWithProgids" Name="Photosweet.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.webp\OpenWithProgids" Name="Photosweet.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.gif\OpenWithProgids" Name="Photosweet.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.bmp\OpenWithProgids" Name="Photosweet.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tga\OpenWithProgids" Name="Photosweet.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.exr\OpenWithProgids" Name="Photosweet.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.hdr\OpenWithProgids" Name="Photosweet.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.avif\OpenWithProgids" Name="Photosweet.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.qoi\OpenWithProgids" Name="Photosweet.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ico\OpenWithProgids" Name="Photosweet.Image" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "photosweet"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe" Name="FriendlyAppName" Value="PhotoSweet" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\shell\open\command" Value="&quot;[#PhotosweetExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".psweet" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".psd" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".psb" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".pdn" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".ora" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".kra" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".krz" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".tif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".tiff" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".webp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".gif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".bmp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".tga" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".exr" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".hdr" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".avif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".qoi" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photosweet.exe\SupportedTypes" Name=".ico" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\photosweet.exe" Value="[#PhotosweetExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\PhotoSweet" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="PhotosweetCli">
        <File Id="PhotosweetCliExe" Source="$(var.BinDir)\photosweet-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
